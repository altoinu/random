{
  "name": "random",
  "version": "1.0.0",
  "description": "Random code, tiny experiments, etc.",
  "private": true,
  "license": "ISC",
  "author": "Kaoru Kawashima",
  "scripts": {
    "format": "(git diff --name-only HEAD; git ls-files --others --exclude-standard) | grep -E '\\.(js|cjs|mjs|jsx|ts|cts|mts|tsx)$' | xargs prettier --write",
    "format:all": "prettier --write \"**/*.{md,css,js,cjs,mjs,jsx,ts,cts,mts,tsx}\"",
    "lint": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altoinu/random.git"
  },
  "bugs": {
    "url": "https://github.com/altoinu/random/issues"
  },
  "homepage": "https://github.com/altoinu/random#readme",
  "devDependencies": {
    "@eslint/css": "^0.13.0",
    "@eslint/js": "^9.37.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.4.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^16.2.4",
    "prettier": "3.6.2",
    "prettier-plugin-sort-imports": "^1.8.8",
    "typescript-eslint": "^8.46.0"
  }
}
